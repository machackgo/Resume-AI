      "principle_id": "OUT01",
      "version": "1.0.0",
      "principle": "Use an actual relevant professional connection and a clear reason for contacting the supplied recipient.",
      "provenance": [
        {
          "source_id": "S14",
          "source_url": "https://capd.mit.edu/resources/conducting-informational-interviews/"
        },
        {
          "source_id": "S15",
