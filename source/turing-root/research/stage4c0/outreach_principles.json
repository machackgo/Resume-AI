        }
      ],
      "evidence_kind": "source_supported",
      "confidence": "high",
      "scope": "context_dependent",
      "conservative_default": null,
      "observable_check": "Personalization cites provided contact or job context.",
      "exceptions_or_limits": []
    },
    {
      "principle_id": "OUT02",
      "version": "1.0.0",
      "principle": "Make one concise, reasonable request and respect the recipient’s time.",
      "provenance": [
        {
          "source_id": "S14",
          "source_url": "https://capd.mit.edu/resources/conducting-informational-interviews/"
        },
        {
          "source_id": "S15",
          "source_url": "https://capd.mit.edu/blog/2025/06/01/building-a-network-digital-and-in-person-strategies-for-students-recent-graduates-and-postdocs/"
        }
      ],
      "evidence_kind": "source_supported",
      "confidence": "high",
      "scope": "context_dependent",
      "conservative_default": null,
      "observable_check": "Single proportionate call to action; no pressure or manufactured urgency.",
      "exceptions_or_limits": []
    },
    {
      "principle_id": "OUT03",
      "version": "1.0.0",
      "principle": "Do not invent referrals, prior meetings, contact details or the recipient’s hiring authority.",
      "provenance": [
        {
          "source_id": "S14",
          "source_url": "https://capd.mit.edu/resources/conducting-informational-interviews/"
        },
