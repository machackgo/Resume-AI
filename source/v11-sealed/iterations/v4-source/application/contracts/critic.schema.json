                  },
                  "minItems": 0,
                  "maxItems": 12,
                  "uniqueItems": true
                }
              },
              "required": [
                "text",
                "kind",
                "verdict",
                "evidence_ids",
                "fact_ids",
                "source_spans",
                "issue_codes"
