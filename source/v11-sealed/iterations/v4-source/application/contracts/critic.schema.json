            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "PARTIALLY_SUPPORTED",
              "UNSUPPORTED",
              "UNKNOWN",
              "NONFACTUAL"
            ]
          },
          "atoms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "ACTION",
                    "TECHNOLOGY",
                    "NUMBER",
                    "DATE",
                    "ENTITY",
                    "SCOPE",
                    "PROVENANCE",
                    "PREFERENCE",
                    "RELATIONSHIP",
                    "JOB_FACT",
