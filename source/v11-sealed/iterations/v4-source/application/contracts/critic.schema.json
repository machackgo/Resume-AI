                      "PARTIAL_SUPPORT",
                      "CONTRADICTION",
                      "WRONG_EVENT",
                      "WRONG_CANDIDATE",
                      "NUMBER_DRIFT",
                      "DATE_DRIFT",
                      "ENTITY_DRIFT",
                      "TECHNOLOGY_DRIFT",
                      "ACTION_ESCALATION",
                      "PROVENANCE_PROMOTION",
                      "INVALID_REFERENCE",
                      "MISSING_REFERENCE",
                      "UNTRUSTED_INSTRUCTION",
                      "JOB_TO_CANDIDATE_TRANSFER",
                      "PREFERENCE_GUESS",
                      "SENSITIVE_FACT_GUESS",
                      "MISSING_REQUIRED_CONTENT",
