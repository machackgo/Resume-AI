          "issue_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "UNSUPPORTED_FACT",
                "UNKNOWN_FACT",
                "PARTIAL_SUPPORT",
                "CONTRADICTION",
                "WRONG_EVENT",
                "WRONG_CANDIDATE",
                "NUMBER_DRIFT",
                "DATE_DRIFT",
                "ENTITY_DRIFT",
                "TECHNOLOGY_DRIFT",
