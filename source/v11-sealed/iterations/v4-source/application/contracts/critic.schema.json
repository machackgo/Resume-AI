                    "type": "string",
                    "minLength": 1,
                    "maxLength": 96,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
                  },
                  "minItems": 0,
                  "maxItems": 40,
                  "uniqueItems": true
                },
                "source_spans": {
                  "type": "array",
